            }
        },
        confirmButton = {
            Button(
                onClick = {
                    if (name.isNotBlank() && roomNo.isNotBlank()) {
                        onSave(
                            Tenant(
                                name = name,
                                mobile = mobile,
                                roomNo = roomNo,
                                address = address,
                                monthlyRent = monthlyRent.toDoubleOrNull() ?: 0.0,
                                securityDeposit = securityDeposit.toDoubleOrNull() ?: 0.0,
                                electricityRate = electricityRate.toDoubleOrNull() ?: 8.0,
                                waterCharges = waterCharges.toDoubleOrNull() ?: 150.0
                            )
                        )
                    }
                },
                colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF1E3A8A))
            ) {
                Text("सुरक्षित करें")
            }
        },
        dismissButton = {
            TextButton(onClick = onDismiss) { Text("रद्द करें") }
        }
    )
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun AddPaymentBillDialog(
    tenant: Tenant,
    onDismiss: () -> Unit,
    onSave: (PaymentRecord) -> Unit
) {
    var monthYear by remember { mutableStateOf("October 2026") }
    var rentAmount by remember { mutableStateOf(tenant.monthlyRent.toInt().toString()) }
    var prevMeter by remember { mutableStateOf("0") }
    var currMeter by remember { mutableStateOf("0") }
    var waterAmount by remember { mutableStateOf(tenant.waterCharges.toInt().toString()) }
    var maintenanceAmount by remember { mutableStateOf("0") }
    var previousDues by remember { mutableStateOf("0") }
    var amountPaid by remember { mutableStateOf("") }
    var paymentMode by remember { mutableStateOf("UPI") }

    val pMeter = prevMeter.toDoubleOrNull() ?: 0.0
    val cMeter = currMeter.toDoubleOrNull() ?: 0.0
    val units = (cMeter - pMeter).coerceAtLeast(0.0)
    val elecAmount = units * tenant.electricityRate

    val rAmount = rentAmount.toDoubleOrNull() ?: 0.0
    val wAmount = waterAmount.toDoubleOrNull() ?: 0.0
    val mAmount = maintenanceAmount.toDoubleOrNull() ?: 0.0
    val pDues = previousDues.toDoubleOrNull() ?: 0.0

    val totalPayable = rAmount + elecAmount + wAmount + mAmount + pDues
    val aPaid = if (amountPaid.isBlank()) totalPayable else (amountPaid.toDoubleOrNull() ?: 0.0)
    val balanceDue = (totalPayable - aPaid).coerceAtLeast(0.0)

    AlertDialog(
        onDismissRequest = onDismiss,
        title = { Text("${tenant.name} - बिल व रसीद", fontWeight = FontWeight.Bold) },
        text = {
            Column(
                modifier = Modifier
                    .verticalScroll(rememberScrollState())
                    .fillMaxWidth(),
                verticalArrangement = Arrangement.spacedBy(8.dp)
            ) {
                Text("कमरा नं: ${tenant.roomNo} | बिजली दर: ₹${tenant.electricityRate}/Unit", fontSize = 12.sp, color = Color.Gray)
                OutlinedTextField(value = monthYear, onValueChange = { monthYear = it }, label = { Text("माह (उदा. October 2026)") })
                OutlinedTextField(value = rentAmount, onValueChange = { rentAmount = it }, label = { Text("किराया (₹)") }, keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number))

                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                    OutlinedTextField(value = prevMeter, onValueChange = { prevMeter = it }, label = { Text("पिछला मीटर") }, modifier = Modifier.weight(1f), keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number))
                    OutlinedTextField(value = currMeter, onValueChange = { currMeter = it }, label = { Text("वर्तमान मीटर") }, modifier = Modifier.weight(1f), keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number))
                }

                Text("खपत: ${units.toInt()} Units × ₹${tenant.electricityRate} = ₹${elecAmount.toInt()} बिजली", color = Color(0xFF1E3A8A), fontWeight = FontWeight.SemiBold, fontSize = 12.sp)

                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                    OutlinedTextField(value = waterAmount, onValueChange = { waterAmount = it }, label = { Text("पानी ₹") }, modifier = Modifier.weight(1f), keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number))
                    OutlinedTextField(value = maintenanceAmount, onValueChange = { maintenanceAmount = it }, label = { Text("अन्य ₹") }, modifier = Modifier.weight(1f), keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number))
                }

                OutlinedTextField(value = previousDues, onValueChange = { previousDues = it }, label = { Text("पुराना बकाया (₹)") }, keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number))

                Card(colors = CardDefaults.cardColors(containerColor = Color(0xFFF1F5F9))) {
                    Column(modifier = Modifier.padding(10.dp)) {
                        Text("कुल देय राशि: ₹${totalPayable.toInt()}", fontWeight = FontWeight.Bold, color = Color(0xFF1E3A8A), fontSize = 16.sp)
                    }
                }

                OutlinedTextField(value = amountPaid, onValueChange = { amountPaid = it }, label = { Text("प्राप्त राशि (Paid Amount ₹)") }, keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number))
                Text("शेष बकाया: ₹${balanceDue.toInt()}", fontWeight = FontWeight.Bold, color = if (balanceDue > 0) Color.Red else Color(0xFF15803D))
            }
        },
        confirmButton = {
            Button(
                onClick = {
                    onSave(
                        PaymentRecord(
                            tenantId = tenant.id,
                            monthYear = monthYear,
                            billingDate = SimpleDateFormat("dd/MM/yyyy", Locale.getDefault()).format(Date()),
                            rentAmount = rAmount,
                            previousMeterReading = pMeter,
                            currentMeterReading = cMeter,
                            unitsConsumed = units,
                            electricityRate = tenant.electricityRate,
                            electricityAmount = elecAmount,
                            waterAmount = wAmount,
                            maintenanceAmount = mAmount,
                            previousDues = pDues,
                            totalPayable = totalPayable,
                            amountPaid = aPaid,
                            balanceDue = balanceDue,
                            paymentMode = paymentMode,
                            notes = ""
                        )
                    )
                },
                colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF1E3A8A))
            ) {
                Text("PDF बनाएँ व सेव करें")
            }
        },
        dismissButton = {
            TextButton(onClick = onDismiss) { Text("रद्द करें") }
        }
    )
}
