@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun SykmMainApp() {
    val context = LocalContext.current
    val viewModel = remember { SykmViewModel(context) }
    val tenants by viewModel.tenants.collectAsState(initial = emptyList())
    val payments by viewModel.allPayments.collectAsState(initial = emptyList())

    var showAddTenantDialog by remember { mutableStateOf(false) }
    var selectedTenantForPayment by remember { mutableStateOf<Tenant?>(null) }
    var searchQuery by remember { mutableStateOf("") }

    // Storage permission launcher for Android 8-12
    val permissionLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.RequestPermission()
    ) { isGranted ->
        if (!isGranted) {
            Toast.makeText(context, "PDF सेव करने के लिए स्टोरेज परमिशन जरूरी है", Toast.LENGTH_LONG).show()
        }
    }

    LaunchedEffect(Unit) {
        if (Build.VERSION.SDK_INT <= Build.VERSION_CODES.P) {
            if (ContextCompat.checkSelfPermission(context, Manifest.permission.WRITE_EXTERNAL_STORAGE)
                != PackageManager.PERMISSION_GRANTED) {
                permissionLauncher.launch(Manifest.permission.WRITE_EXTERNAL_STORAGE)
            }
        }
    }

    Scaffold(
        topBar = {
            TopAppBar(
                title = {
                    Column {
                        Text("SYKM - किरायेदार प्रबंधन", fontWeight = FontWeight.Bold, fontSize = 18.sp)
                        Text("कमरे, किराया, बिजली बिल और PDF रसीद", fontSize = 12.sp, color = Color.LightGray)
                    }
                },
                colors = TopAppBarDefaults.topAppBarColors(
                    containerColor = Color(0xFF1E3A8A),
                    titleContentColor = Color.White
                )
            )
        },
        floatingActionButton = {
            ExtendedFloatingActionButton(
                onClick = { showAddTenantDialog = true },
                containerColor = Color(0xFF1E3A8A),
                contentColor = Color.White,
                icon = { Icon(Icons.Default.Add, contentDescription = "Add") },
                text = { Text("नया किरायेदार") }
            )
        }
    ) { padding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(padding)
                .padding(16.dp)
        ) {
            // Dashboard Summary Cards
            val totalTenants = tenants.size
            val totalCollection = payments.sumOf { it.amountPaid }
            val totalPending = payments.sumOf { it.balanceDue }

            Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                Card(
                    modifier = Modifier.weight(1f),
                    colors = CardDefaults.cardColors(containerColor = Color(0xFFEFF6FF))
                ) {
                    Column(modifier = Modifier.padding(12.dp)) {
                        Text("कुल किरायेदार", fontSize = 12.sp, color = Color(0xFF1E40AF))
                        Text("$totalTenants", fontSize = 20.sp, fontWeight = FontWeight.Bold, color = Color(0xFF1E3A8A))
                    }
                }
                Card(
                    modifier = Modifier.weight(1f),
                    colors = CardDefaults.cardColors(containerColor = Color(0xFFECFDF5))
                ) {
                    Column(modifier = Modifier.padding(12.dp)) {
                        Text("कुल वसूली", fontSize = 12.sp, color = Color(0xFF065F46))
                        Text("₹${totalCollection.toInt()}", fontSize = 18.sp, fontWeight = FontWeight.Bold, color = Color(0xFF047857))
                    }
                }
                Card(
                    modifier = Modifier.weight(1f),
                    colors = CardDefaults.cardColors(containerColor = Color(0xFFFEF2F2))
                ) {
                    Column(modifier = Modifier.padding(12.dp)) {
                        Text("बकाया", fontSize = 12.sp, color = Color(0xFF991B1B))
                        Text("₹${totalPending.toInt()}", fontSize = 18.sp, fontWeight = FontWeight.Bold, color = Color(0xFFDC2626))
                    }
                }
            }

            Spacer(modifier = Modifier.height(16.dp))

            // Search Bar
            OutlinedTextField(
                value = searchQuery,
                onValueChange = { searchQuery = it },
                label = { Text("किरायेदार या कमरा नं खोजें...") },
                leadingIcon = { Icon(Icons.Default.Search, contentDescription = "Search") },
                modifier = Modifier.fillMaxWidth(),
                singleLine = true,
                shape = RoundedCornerShape(12.dp)
            )

            Spacer(modifier = Modifier.height(12.dp))

            // Tenant List
            val filteredTenants = tenants.filter {
                it.name.contains(searchQuery, ignoreCase = true) ||
                it.roomNo.contains(searchQuery, ignoreCase = true) ||
                it.mobile.contains(searchQuery)
            }

            if (filteredTenants.isEmpty()) {
                Box(modifier = Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
                    Column(horizontalAlignment = Alignment.CenterHorizontally) {
                        Icon(Icons.Default.Person, contentDescription = null, modifier = Modifier.size(64.dp), tint = Color.Gray)
                        Spacer(modifier = Modifier.height(8.dp))
                        Text("कोई किरायेदार नहीं मिला", color = Color.Gray)
                        Text("नीचे दिए बटन से किरायेदार जोड़ें", fontSize = 12.sp, color = Color.LightGray)
                    }
                }
            } else {
                LazyColumn(
                    verticalArrangement = Arrangement.spacedBy(10.dp),
                    modifier = Modifier.fillMaxSize()
                ) {
                    items(filteredTenants) { tenant ->
                        TenantCard(
                            tenant = tenant,
                            onAddBillClick = { selectedTenantForPayment = tenant },
                            onCallClick = {
                                val intent = Intent(Intent.ACTION_DIAL, Uri.parse("tel:${tenant.mobile}"))
                                context.startActivity(intent)
                            },
                            onWhatsAppClick = {
                                val url = "https://api.whatsapp.com/send?phone=91${tenant.mobile}&text=नमस्ते ${tenant.name} जी, यह SYKM ऐप से किराया सूचना है।"
                                val intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
                                context.startActivity(intent)
                            }
                        )
                    }
                }
            }
        }
    }

    // Dialogs
    if (showAddTenantDialog) {
        AddTenantDialog(
            onDismiss = { showAddTenantDialog = false },
            onSave = { newTenant ->
                viewModel.addTenant(newTenant)
                showAddTenantDialog = false
                Toast.makeText(context, "किरायेदार सफलतापूर्वक जोड़ा गया!", Toast.LENGTH_SHORT).show()
            }
        )
    }

    selectedTenantForPayment?.let { tenant ->
        AddPaymentBillDialog(
            tenant = tenant,
            onDismiss = { selectedTenantForPayment = null },
            onSave = { payment ->
                viewModel.addPayment(payment)
                val pdfFile = PdfGenerator.generateBillPdf(context, tenant, payment)
                selectedTenantForPayment = null
                if (pdfFile != null && pdfFile.exists()) {
                    Toast.makeText(context, "PDF बिल सेव हुआ: Documents/SYKM_Bills", Toast.LENGTH_LONG).show()
                } else {
                    Toast.makeText(context, "भुगतान दर्ज हो गया!", Toast.LENGTH_SHORT).show()
                }
            }
        )
    }
}

