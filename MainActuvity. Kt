@Composable
fun AddTenantDialog(
    onDismiss: () -> Unit,
    onSave: (Tenant) -> Unit
) {
    var name by remember { mutableStateOf("") }
    var mobile by remember { mutableStateOf("") }
    var roomNo by remember { mutableStateOf("") }
    var address by remember { mutableStateOf("") }
    var monthlyRent by remember { mutableStateOf("") }
    var securityDeposit by remember { mutableStateOf("") }
    var electricityRate by remember { mutableStateOf("8") }
    var waterCharges by remember { mutableStateOf("150") }

    AlertDialog(
        onDismissRequest = onDismiss,
        title = { Text("नया किरायेदार जोड़ें", fontWeight = FontWeight.Bold) },
        text = {
            Column(
                modifier = Modifier
                    .verticalScroll(rememberScrollState())
                    .fillMaxWidth(),
                verticalArrangement = Arrangement.spacedBy(8.dp)
            ) {
                OutlinedTextField(value = name, onValueChange = { name = it }, label = { Text("किरायेदार का नाम *") })
                OutlinedTextField(value = mobile, onValueChange = { mobile = it }, label = { Text("मोबाइल नंबर *") }, keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Phone))
                OutlinedTextField(value = roomNo, onValueChange = { roomNo = it }, label = { Text("कमरा / रूम नंबर *") })
                OutlinedTextField(value = address, onValueChange = { address = it }, label = { Text("स्थायी पता") })
                OutlinedTextField(value = monthlyRent, onValueChange = { monthlyRent = it }, label = { Text("मासिक किराया (₹) *") }, keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number))
                OutlinedTextField(value = securityDeposit, onValueChange = { securityDeposit = it }, label = { Text("सिक्योरिटी डिपॉज़िट (₹)") }, keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number))
                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                    OutlinedTextField(value = electricityRate, onValueChange = { electricityRate = it }, label = { Text("बिजली ₹/Unit") }, modifier = Modifier.weight(1f), keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number))
                    OutlinedTextField(value = waterCharges, onValueChange = { waterCharges = it }, label = { Text("पानी शुल्क ₹") }, modifier = Modifier.weight(1f), keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number))
