// ==========================================
// 1. ROOM DATABASE ENTITIES & DAO
// ==========================================

@Entity(tableName = "tenants")
data class Tenant(
    @PrimaryKey(autoGenerate = true) val id: Long = 0,
    val name: String,
    val mobile: String,
    val address: String,
    val roomNo: String,
    val monthlyRent: Double,
    val securityDeposit: Double,
    val electricityRate: Double,
    val waterCharges: Double,
    val joiningDate: String = SimpleDateFormat("dd/MM/yyyy", Locale.getDefault()).format(Date()),
    val isActive: Boolean = true
)

@Entity(
    tableName = "payments",
    foreignKeys = [
        ForeignKey(
            entity = Tenant::class,
            parentColumns = ["id"],
            childColumns = ["tenantId"],
            onDelete = ForeignKey.CASCADE
        )
    ],
    indices = [Index(value = ["tenantId"])]
)
data class PaymentRecord(
    @PrimaryKey(autoGenerate = true) val id: Long = 0,
    val tenantId: Long,
    val monthYear: String,
    val billingDate: String,
    val rentAmount: Double,
    val previousMeterReading: Double,
    val currentMeterReading: Double,
    val unitsConsumed: Double,
    val electricityRate: Double,
    val electricityAmount: Double,
    val waterAmount: Double,
    val maintenanceAmount: Double,
    val previousDues: Double,
    val totalPayable: Double,
    val amountPaid: Double,
    val balanceDue: Double,
    val paymentMode: String,
    val notes: String
)

@Dao
interface TenantDao {
    @Query("SELECT * FROM tenants WHERE isActive = 1 ORDER BY roomNo ASC")
    fun getAllActiveTenants(): Flow<List<Tenant>>

    @Insert(onConflict = OnConflictStrategy.REPLACE)
    suspend fun insertTenant(tenant: Tenant): Long

    @Update
    suspend fun updateTenant(tenant: Tenant)

    @Delete
    suspend fun deleteTenant(tenant: Tenant)

    @Query("SELECT * FROM tenants WHERE id = :id LIMIT 1")
    suspend fun getTenantById(id: Long): Tenant?
}

@Dao
interface PaymentDao {
    @Query("SELECT * FROM payments WHERE tenantId = :tenantId ORDER BY id DESC")
    fun getPaymentsForTenant(tenantId: Long): Flow<List<PaymentRecord>>

    @Query("SELECT * FROM payments ORDER BY id DESC")
    fun getAllPayments(): Flow<List<PaymentRecord>>

    @Insert(onConflict = OnConflictStrategy.REPLACE)
    suspend fun insertPayment(payment: PaymentRecord): Long
}

@Database(entities = [Tenant::class, PaymentRecord::class], version = 1, exportSchema = false)
abstract class AppDatabase : RoomDatabase() {
    abstract fun tenantDao(): TenantDao
    abstract fun paymentDao(): PaymentDao

    companion object {
        @Volatile
        private var INSTANCE: AppDatabase? = null

        fun getDatabase(context: Context): AppDatabase {
            return INSTANCE ?: synchronized(this) {
                val instance = Room.databaseBuilder(
                    context.applicationContext,
                    AppDatabase::class.java,
                    "sykm_tenant_database"
                ).build()
                INSTANCE = instance
                instance
            }
        }
    }
}

// ==========================================
// 2. VIEWMODEL
// ==========================================

class SykmViewModel(context: Context) : ViewModel() {
    private val db = AppDatabase.getDatabase(context)
    val tenants = db.tenantDao().getAllActiveTenants()
    val allPayments = db.paymentDao().getAllPayments()

    fun addTenant(tenant: Tenant) {
        viewModelScope.launch {
            db.tenantDao().insertTenant(tenant)
        }
    }

    fun addPayment(payment: PaymentRecord) {
        viewModelScope.launch {
            db.paymentDao().insertPayment(payment)
        }
    }

    fun deleteTenant(tenant: Tenant) {
        viewModelScope.launch {
            db.tenantDao().deleteTenant(tenant)
        }
    }
}

// ==========================================
// 3. ITEXT7 PDF GENERATOR
// ==========================================

object PdfGenerator {
    fun generateBillPdf(
        context: Context,
        tenant: Tenant,
        payment: PaymentRecord
    ): File? {
        return try {
            val docsFolder = File(
                Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DOCUMENTS),
                "SYKM_Bills"
            )
            if (!docsFolder.exists()) {
                docsFolder.mkdirs()
            }

            val fileName = "SYKM_Bill_${tenant.roomNo}_${payment.monthYear.replace(" ", "_")}_${System.currentTimeMillis()}.pdf"
            val file = File(docsFolder, fileName)

            val writer = PdfWriter(FileOutputStream(file))
            val pdfDoc = PdfDocument(writer)
            val doc = Document(pdfDoc, PageSize.A4)
            doc.setMargins(20f, 20f, 20f, 20f)

            // Header
            val headerTitle = Paragraph("SYKM - किरायेदार किराया एवं बिजली बिल")
                .setFontSize(20f)
                .setBold()
                .setTextAlignment(TextAlignment.CENTER)
                .setFontColor(ColorConstants.BLUE)
            doc.add(headerTitle)

            val subTitle = Paragraph("शुभम यादव निवास | रसीद / बिल माह: ${payment.monthYear}")
                .setFontSize(12f)
                .setTextAlignment(TextAlignment.CENTER)
            doc.add(subTitle)

            doc.add(Paragraph("\n----------------------------------------------------------------------------------------------------"))

            // Tenant Details Table
            val infoTable = Table(UnitValue.createPercentArray(floatArrayOf(50f, 50f))).useAllAvailableWidth()
            infoTable.addCell(Cell().add(Paragraph("किरायेदार का नाम: ${tenant.name}").setBold()))
            infoTable.addCell(Cell().add(Paragraph("कमरा / रूम नं: ${tenant.roomNo}").setBold()))
            infoTable.addCell(Cell().add(Paragraph("मोबाइल नंबर: ${tenant.mobile}")))
            infoTable.addCell(Cell().add(Paragraph("बिलिंग तिथि: ${payment.billingDate}")))
            infoTable.addCell(Cell().add(Paragraph("स्थायी पता: ${tenant.address}")))
            infoTable.addCell(Cell().add(Paragraph("भुगतान माध्यम: ${payment.paymentMode}")))
            doc.add(infoTable)

            doc.add(Paragraph("\nखर्च एवं बिल का विवरण:").setBold().setFontSize(14f))

            // Charges Breakdown Table
            val billTable = Table(UnitValue.createPercentArray(floatArrayOf(10f, 50f, 40f))).useAllAvailableWidth()
            billTable.addHeaderCell(Cell().add(Paragraph("क्र.").setBold()))
            billTable.addHeaderCell(Cell().add(Paragraph("विवरण (Description)").setBold()))
            billTable.addHeaderCell(Cell().add(Paragraph("राशि (₹ Amount)").setBold()))

            billTable.addCell("1")
            billTable.addCell("मासिक कमरा किराया (Room Rent)")
            billTable.addCell("₹${payment.rentAmount}")

            billTable.addCell("2")
            billTable.addCell("बिजली खपत (${payment.unitsConsumed} Units @ ₹${payment.electricityRate}/Unit)\n[रीडिंग: ${payment.previousMeterReading} से ${payment.currentMeterReading}]")
            billTable.addCell("₹${payment.electricityAmount}")

            billTable.addCell("3")
            billTable.addCell("पानी का शुल्क (Water Charges)")
            billTable.addCell("₹${payment.waterAmount}")

            if (payment.maintenanceAmount > 0) {
                billTable.addCell("4")
                billTable.addCell("मेंटेनेंस / अन्य शुल्क (Maintenance/Other)")
                billTable.addCell("₹${payment.maintenanceAmount}")
            }

            if (payment.previousDues > 0) {
                billTable.addCell("5")
                billTable.addCell("पिछला बकाया (Previous Pending Dues)")
                billTable.addCell("₹${payment.previousDues}")
            }

            doc.add(billTable)

            doc.add(Paragraph("\n"))

            // Summary Box
            val summaryTable = Table(UnitValue.createPercentArray(floatArrayOf(60f, 40f))).useAllAvailableWidth()
            summaryTable.addCell(Cell().add(Paragraph("कुल देय राशि (Total Payable):").setBold()))
            summaryTable.addCell(Cell().add(Paragraph("₹${payment.totalPayable}").setBold().setFontSize(14f)))

            summaryTable.addCell(Cell().add(Paragraph("जमा की गई राशि (Amount Paid):").setBold()))
            summaryTable.addCell(Cell().add(Paragraph("₹${payment.amountPaid}").setBold().setFontColor(ColorConstants.DARK_GRAY)))

            summaryTable.addCell(Cell().add(Paragraph("शेष बकाया राशि (Balance Due):").setBold()))
            summaryTable.addCell(Cell().add(Paragraph("₹${payment.balanceDue}").setBold().setFontColor(if (payment.balanceDue > 0) ColorConstants.RED else ColorConstants.GREEN)))

            doc.add(summaryTable)

            doc.add(Paragraph("\n\nनोट: कृपया समय पर किराया भुगतान करें। धन्यवाद!\n"))
            doc.add(Paragraph("हस्ताक्षर (मकान मालिक)                     हस्ताक्षर (किरायेदार)\n").setTextAlignment(TextAlignment.RIGHT))

            doc.close()
            file
        } catch (e: Exception) {
            e.printStackTrace()
            null
        }
    }
}

